+// THROWAWAY MOCKUP (gallery view=millermock): the grumpy miller, a mission NPC for the Charm challenge
+// (docs/BASE_DESIGN.md 5.3, 6), drawn through the real keeper rig (src/art/keeper/: cast.ts NPCS, palettes.ts,
+// parts.ts's flat cap / moustache / sack / grumpy and glad faces, anims.ts millerAnims). One 640 x 360 sheet:
+//   (1) the miller GRUMPY, (2) Bea waving at him (her own `wave`), side by side in front of the mill at Highfold on the
+//   pale road; (3) the miller TALKED ROUND, the same framing; (4) the ÷ 3 silhouettes of the miller (carrying his
+//   sack, grumpy, talked round) beside the four keepers', blown up and at 1x, and his two faces x3.
+// Not a game scene: nothing here is stepped live; every figure is posed once, deterministically, at its frame.
+import { drawText } from '../lib/engine/text.ts';
+import { buildKeeper, drawKeeper, stepKeeper, keeperJoint } from '../art/keeper/rig.ts';
+import type { KeeperRig } from '../art/keeper/rig.ts';
+import { KeeperPlayer } from '../art/keeper/player.ts';
+import { keeperAnims, millerAnims } from '../art/keeper/anims.ts';
