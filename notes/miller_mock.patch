+// ---------- the ÷ 3 silhouette reduction (gallery view=silhouette's: ink when >= 50 % of the 3 x 3 box is covered) ----------
+
+function reduce3(src: HTMLCanvasElement): HTMLCanvasElement {
+  const W = src.width, H = src.height, RW = Math.ceil(W / 3), RH = Math.ceil(H / 3);
+  const d = src.getContext('2d')!.getImageData(0, 0, W, H).data;
+  const out = document.createElement('canvas'); out.width = RW; out.height = RH;
+  const g = out.getContext('2d')!, img = g.createImageData(RW, RH);
+  for (let Y = 0; Y < RH; Y++) for (let X = 0; X < RW; X++) {
+    let cov = 0;
+    for (let dy = 0; dy < 3; dy++) for (let dx = 0; dx < 3; dx++) {
+      const sx = X * 3 + dx, sy = Y * 3 + dy;
+      if (sx >= W || sy >= H) continue;
+      cov += (255 - d[(sy * W + sx) * 4]) / (255 - 0x1a);
+    }
+    const o = (Y * RW + X) * 4, ink = cov / 9 >= 0.5;
+    img.data[o] = ink ? 0x1a : 0xf4; img.data[o + 1] = ink ? 0x10 : 0xef; img.data[o + 2] = ink ? 0x18 : 0xe2; img.data[o + 3] = 255;
+  }
+  g.putImageData(img, 0, 0);
+  return out;
+}
