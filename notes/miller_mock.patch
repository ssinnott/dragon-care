+/** A figure on the keeper rig, playing `anim` from its start, stepped `seek` frames, blinks off (the authored face). */
+function fig(id: CastId, anim: string, x: number, y: number, facing: number, seek = 0): Fig {
+  const rig = buildKeeper(id);
+  const player = new KeeperPlayer(id === 'miller' ? millerAnims(rig.spec) : keeperAnims(rig.spec), 3);
+  player.blinks = false;
+  if (rig.spec.tool === 'brush') rig.weapon = TOOL_BRUSH;
+  player.play(anim, { restart: true });
+  for (let i = 0; i < seek; i++) player.tick();
